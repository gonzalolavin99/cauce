# Variables de entorno de Cauce
# Copia este archivo a `.env.local` para desarrollo local.
# En producción (Netlify), defínelas en Site settings > Environment variables.
#
# IMPORTANTE: las variables con prefijo EXPO_PUBLIC_ se INYECTAN en el bundle
# en tiempo de build (`expo export`). No pongas secretos de servidor aquí.

# Supabase (requeridas)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Sentry (opcional) — reporte de errores.
# Si se define, se inicializa Sentry al arrancar (web y nativo).
# Si se omite, el logger cae a consola y la app funciona igual.
# El DSN es una clave PÚBLICA de cliente, segura de exponer en el bundle.
EXPO_PUBLIC_SENTRY_DSN=
